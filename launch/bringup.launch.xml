<?xml version="1.0"?>
<launch>
    <arg name="equirectangular" default="false"/>
    <arg name="imu_filter" default="true"/>
    <arg name="equirectangular_config" default="$(find-pkg-share insta360_ros_driver)/config/equirectangular.yaml"/>
    <arg name="imu_config" default="$(find-pkg-share insta360_ros_driver)/config/imu_filter.yaml"/>
    <!-- Requested live-stream resolution as "WIDTHxHEIGHT". Supported values:
         3840x1920, 2880x2880, 2560x1280, 2304x1152, 1920x960, 1440x720.
         Actual delivered resolution is negotiated per camera model (e.g. X5 is capped). -->
    <arg name="video_resolution" default="1920x960"/>
    <arg name="video_bitrate" default="524288"/>
    <!-- H.264 decode backend: auto | cuvid | software | openh264.
         Output-buffer latency floors measured on the X5 stream (see
         docs/camera_latency_check.md in the parent repo):
         openh264 (1 frame) < software (2 frames) < cuvid (3 frames). -->
    <arg name="decoder" default="auto"/>
    <!-- Substitute the camera's low-res (~1024x512) preview stream for the
         main 2656x1328 one. Latency experiment: smaller encode may shrink the
         camera-side encode buffer. (Verified no-op on X5 fw 1.1.22.) -->
    <arg name="using_lrv" default="false"/>
    <!-- SDK 2.1.1 X4/X5 live-view flow: SetVideoSubMode(VIDEO_LIVEVIEW) +
         SetVideoCaptureParams(FUNCTION_MODE_LIVE_STREAM) before streaming.
         The SDK example claims this makes the X5 preview resolution follow
         video_resolution instead of being fixed at 2656x1328. -->
    <arg name="live_view_mode" default="false"/>
    <!-- Sensor selection: front | rear | all | "" (leave camera as-is).
         DO NOT USE ON X5: verified (fw 1.1.22) to instantly drop the USB
         session and reset the camera out of Android USB mode (recovery =
         re-select Android mode + replug). Kept for other models only. -->
    <arg name="active_sensor" default=""/>
    <!-- Publish only one lens of the dual-fisheye frame: full | front | back.
         front = right half. Halves the raw-image payload; use full for VIO /
         anything needing both lenses. The latency probe then needs its lens
         option set to "full" (the frame is already single-lens). -->
    <arg name="publish_lens" default="full"/>

    <!-- Multi-camera support. To run two X5s, launch this file twice with distinct
         namespaces + serials, e.g.:
           ros2 launch insta360_ros_driver bringup.launch.xml namespace:=cam3 serial:=IAHYA25116W5XY frame_prefix:=cam3_
           ros2 launch insta360_ros_driver bringup.launch.xml namespace:=cam4 serial:=IAHYA2511BS4S3 frame_prefix:=cam4_
         Topics then publish under /cam3/dual_fisheye/image, /cam4/dual_fisheye/image, etc.
         Leave all three empty (default) for the single-camera case (topics at root). -->
    <arg name="namespace" default=""/>
    <arg name="serial" default=""/>
    <arg name="frame_prefix" default=""/>

    <group>
        <push-ros-namespace namespace="$(var namespace)"/>

        <!-- Publishes Compressed Images + IMU for the selected camera -->
        <node pkg="insta360_ros_driver" exec="insta360_ros_driver" name="insta360_ros_driver" output="log">
            <param name="video_resolution" value="$(var video_resolution)"/>
            <param name="video_bitrate" value="$(var video_bitrate)"/>
            <param name="using_lrv" value="$(var using_lrv)"/>
            <param name="live_view_mode" value="$(var live_view_mode)"/>
            <param name="active_sensor" value="$(var active_sensor)"/>
            <param name="serial" value="$(var serial)"/>
            <param name="frame_prefix" value="$(var frame_prefix)"/>
        </node>

        <!-- Decodes Compressed Images. Relative topics resolve under the namespace. -->
        <node pkg="insta360_ros_driver" exec="decoder" name="image_decoder" output="log">
            <param name="compressed_topic" value="dual_fisheye/image/compressed"/>
            <param name="uncompressed_topic" value="dual_fisheye/image"/>
            <param name="frame_prefix" value="$(var frame_prefix)"/>
            <param name="decoder" value="$(var decoder)"/>
            <param name="publish_lens" value="$(var publish_lens)"/>
            <!-- We can skip decoding every <skip_frame>. So skip_frame = 1 will only publish half the frames, etc. -->
            <param name="skip_frame" value="0"/>
            <!-- If you want to minimize the CPU load the most, you can decode only the i-frames. But the expected FPS is about 1-2 FPS -->
            <param name="i_frame_only" value="false"/>
        </node>

        <!-- Creates Equirectangular Images -->
        <node if="$(var equirectangular)" pkg="insta360_ros_driver" exec="equirectangular_cpp" name="equirectangular_node" output="screen">
            <param from="$(var equirectangular_config)" />
        </node>

        <!-- Applies a Madgwick Filter to the 6-DOF IMU to get Orientation -->
        <node if="$(var imu_filter)" pkg="imu_filter_madgwick" exec="imu_filter_madgwick_node" name="imu_filter" output="log">
            <param from="$(var imu_config)"/>
        </node>
    </group>
</launch>
